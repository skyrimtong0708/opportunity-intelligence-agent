OIA_DATABASE_URL=sqlite:///data/runtime/oia.db
POSTGRES_PASSWORD=replace-with-a-long-random-password
# PostgreSQL example; insert the same local password without committing .env:
# OIA_DATABASE_URL=postgresql://oia:<password>@localhost:5432/oia

# Official/authorized source adapters. Leave blank to keep adapters inert.
YOUTUBE_API_KEY=
TIKTOK_DISPLAY_ACCESS_TOKEN=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
